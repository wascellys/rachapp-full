# Django
DEBUG=True
SECRET_KEY=sua-chave-secreta-muito-segura-aqui
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/rachas_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://192.168.0.7:3000,

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=seu-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=seu-google-client-secret

# Facebook OAuth
FACEBOOK_APP_ID=seu-facebook-app-id
FACEBOOK_APP_SECRET=seu-facebook-app-secret

# Email (Resend Python SDK)
EMAIL_BACKEND=rachas.email_backend.ResendEmailBackend
RESEND_API_KEY=sua-chave-api-resend
RESEND_TIMEOUT=10
DEFAULT_FROM_EMAIL=RachApp <noreply@rachapp.com.br>


